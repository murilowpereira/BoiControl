{
  "name": "boicontrol-functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=lib/index.js --packages=external --alias:@boicontrol/core=../packages/core/src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "firebase emulators:exec --only firestore --project demo-boicontrol --config ../firebase.json \"vitest run\""
  },
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12"
  }
}
