{
  "name": "boicontrol",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:rules": "firebase emulators:exec --only firestore --project demo-boicontrol \"vitest run --root tests/rules\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-boicontrol \"bash tests/e2e/rodar.sh\"",
    "emuladores": "firebase emulators:start --only auth,firestore --project demo-boicontrol",
    "test:backup": "firebase emulators:exec --only auth,firestore --project demo-boicontrol \"vitest run --root tests/backup\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.34.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
