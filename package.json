{
  "name": "boicontrol",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "functions",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:rules": "firebase emulators:exec --only firestore --project demo-boicontrol \"vitest run --root tests/rules\"",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
