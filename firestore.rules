rules_version = '2';

// Regras do BoiControl (plano Spark, sem Cloud Functions).
//
// Sem servidor próprio, as garantias da especificação ficam aqui:
// - brinco único por propriedade: documento brincos/{brinco} criado na mesma
//   gravação do animal (create falha se já existir);
// - código interno sequencial e imutável: contador incrementado na mesma gravação;
// - auditoria obrigatória: toda alteração crítica exige, na mesma gravação, um
//   registro em auditoria/{entidade}_{id}_v{versao} com os valores antes/depois;
// - histórico preservado: pesagens nunca são apagadas, só corrigidas ou anuladas.
//
// Pesagens podem ser gravadas offline. Para que uma recusa não se perca depois
// que o app é reaberto, a criação de pesagem só verifica autorização e formato,
// que o app já valida antes de gravar. Situações de negócio (animal inativado
// enquanto o celular estava offline, data no futuro) são sinalizadas na tela.
service cloud.firestore {
  match /databases/{database}/documents {

    function caminhoMembro(pid) {
      return /databases/$(database)/documents/propriedades/$(pid)/membros/$(request.auth.uid);
    }

    function membroAtivo(pid) {
      return request.auth != null
        && exists(caminhoMembro(pid))
        && get(caminhoMembro(pid)).data.ativo == true;
    }

    function temPerfil(pid, perfis) {
      return membroAtivo(pid) && get(caminhoMembro(pid)).data.perfil in perfis;
    }

    function textoOpcional(v, max) {
      return v == null || (v is string && v.size() <= max);
    }

    function textoObrigatorio(v, max) {
      return v is string && v.trim().size() > 0 && v.size() <= max;
    }

    // Peso em gramas inteiros, múltiplo de 10 g (duas casas em kg), até 2.000 kg.
    function pesoValido(p) {
      return p is int && p > 0 && p <= 2000000 && p % 10 == 0;
    }

    function brincoValido(b) {
      return b is string && b.matches('^[A-Z0-9-]{1,30}$');
    }

    function dataOpcional(d) {
      return d == null || (d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    // GET /me da spec: o app descobre as propriedades do usuário por uma
    // consulta de grupo em "membros" filtrando pelo próprio uid.
    match /{caminho=**}/membros/{uid} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // E-mail verificado do usuário (contas Google sempre têm), em minúsculas.
    function emailVerificado() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    // Convites: quem entra pela primeira vez descobre o convite pelo próprio e-mail.
    match /{caminho=**}/convites/{email} {
      allow read: if emailVerificado() && resource.data.email == request.auth.token.email.lower();
    }

    match /propriedades/{pid} {
      function p(colecao, id) {
        return /databases/$(database)/documents/propriedades/$(pid)/$(colecao)/$(id);
      }

      function categoriaAtiva(id) {
        return exists(p('categorias', id)) && get(p('categorias', id)).data.ativo == true;
      }

      // Lote/pasto é opcional: null ou um lote ativo.
      function loteValido(id) {
        return id == null || (id is string && exists(p('lotes', id)) && get(p('lotes', id)).data.ativo == true);
      }

      function configuracoesValidas(c) {
        return c is map
          && c.keys().hasOnly(['diasAlertaPesagem', 'pesoAbateKg'])
          && (!('diasAlertaPesagem' in c) || (c.diasAlertaPesagem is int && c.diasAlertaPesagem >= 1 && c.diasAlertaPesagem <= 365))
          && (!('pesoAbateKg' in c) || (c.pesoAbateKg is int && c.pesoAbateKg >= 100 && c.pesoAbateKg <= 1500));
      }

      function auditoriaGravada(entidade, id, versao) {
        return existsAfter(p('auditoria', entidade + '_' + id + '_v' + string(versao)));
      }

      function auditoriaDe(entidade, id, versao) {
        return getAfter(p('auditoria', entidade + '_' + id + '_v' + string(versao))).data;
      }

      allow read: if membroAtivo(pid);
      allow update: if temPerfil(pid, ['ADMIN'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'configuracoes'])
        && textoObrigatorio(request.resource.data.nome, 80)
        && configuracoesValidas(request.resource.data.get('configuracoes', {}));
      allow create, delete: if false;

      function perfilValido(v) {
        return v in ['ADMIN', 'OPERADOR', 'CONSULTA'];
      }

      // Membros: o doc tem o uid como ID. O ADMIN não sabe o uid de quem ainda não
      // entrou, então convida pelo e-mail; a pessoa vira membro ao aceitar o convite.
      match /membros/{uid} {
        allow read: if membroAtivo(pid);

        // Aceite: só o próprio convidado, com o perfil do convite, consumindo-o na mesma gravação.
        allow create: if emailVerificado()
          && uid == request.auth.uid
          && exists(p('convites', request.auth.token.email.lower()))
          && request.resource.data.keys().hasOnly(['uid', 'nome', 'email', 'perfil', 'ativo'])
          && request.resource.data.uid == uid
          && request.resource.data.email == request.auth.token.email.lower()
          && request.resource.data.nome == get(p('convites', request.auth.token.email.lower())).data.nome
          && request.resource.data.perfil == get(p('convites', request.auth.token.email.lower())).data.perfil
          && request.resource.data.ativo == true
          && !existsAfter(p('convites', request.auth.token.email.lower()));

        // ADMIN muda perfil e ativa/desativa os outros (nunca a si mesmo, para não ficar sem ADMIN).
        allow update: if temPerfil(pid, ['ADMIN'])
          && uid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['perfil', 'ativo'])
          && perfilValido(request.resource.data.perfil)
          && request.resource.data.ativo is bool;

        allow delete: if false;
      }

      match /convites/{email} {
        allow read: if temPerfil(pid, ['ADMIN']);
        allow create, update: if temPerfil(pid, ['ADMIN'])
          && email.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+[.][a-z]{2,}$')
          && request.resource.data.keys().hasOnly(['email', 'nome', 'perfil', 'convidadoPor', 'convidadoEm'])
          && request.resource.data.email == email
          && textoObrigatorio(request.resource.data.nome, 80)
          && perfilValido(request.resource.data.perfil)
          && request.resource.data.convidadoPor == request.auth.uid
          && request.resource.data.convidadoEm == request.time;
        // ADMIN cancela; o convidado apaga ao aceitar (junto com a criação do vínculo).
        allow delete: if temPerfil(pid, ['ADMIN'])
          || (emailVerificado()
              && email == request.auth.token.email.lower()
              && existsAfter(p('membros', request.auth.uid)));
      }

      match /categorias/{categoriaId} {
        allow read: if membroAtivo(pid);
        allow create, update: if temPerfil(pid, ['ADMIN'])
          && request.resource.data.keys().hasOnly(['nome', 'ativo'])
          && textoObrigatorio(request.resource.data.nome, 40)
          && request.resource.data.ativo is bool;
        allow delete: if false;
      }

      // Lotes ou pastos: mesmo formato das categorias. Desativar não mexe nos animais.
      match /lotes/{loteId} {
        allow read: if membroAtivo(pid);
        allow create, update: if temPerfil(pid, ['ADMIN'])
          && request.resource.data.keys().hasOnly(['nome', 'ativo'])
          && textoObrigatorio(request.resource.data.nome, 40)
          && request.resource.data.ativo is bool;
        allow delete: if false;
      }

      // ------------------------------------------------------------- financeiro
      // Valores ficam fora do documento do animal para que só o ADMIN os veja
      // (operador e consulta leem os animais, mas não quanto custaram).
      function valorOpcional(v) {
        return v == null || (v is int && v > 0 && v <= 10000000000);
      }

      match /valoresAnimais/{animalId} {
        allow read: if temPerfil(pid, ['ADMIN']);
        allow create, update: if temPerfil(pid, ['ADMIN'])
          && existsAfter(p('animais', animalId))
          && request.resource.data.keys().hasOnly(['compraCentavos', 'dataCompra', 'vendaCentavos', 'dataVenda', 'atualizadoPor', 'atualizadoEm'])
          && valorOpcional(request.resource.data.get('compraCentavos', null))
          && valorOpcional(request.resource.data.get('vendaCentavos', null))
          && dataOpcional(request.resource.data.get('dataCompra', null))
          && dataOpcional(request.resource.data.get('dataVenda', null))
          && request.resource.data.atualizadoPor == request.auth.uid
          && request.resource.data.atualizadoEm == request.time;
        allow delete: if false;
      }

      match /lancamentos/{lancamentoId} {
        allow read, delete: if temPerfil(pid, ['ADMIN']);
        allow create, update: if temPerfil(pid, ['ADMIN'])
          && request.resource.data.keys().hasOnly(['categoria', 'descricao', 'valorCentavos', 'data', 'criadoPor', 'criadoEm', 'atualizadoPor', 'atualizadoEm'])
          && request.resource.data.categoria in ['RACAO', 'SAL_MINERAL', 'SANIDADE', 'PASTAGEM', 'MAO_DE_OBRA', 'COMBUSTIVEL', 'MANUTENCAO', 'OUTRAS_DESPESAS', 'OUTRAS_RECEITAS']
          && textoOpcional(request.resource.data.get('descricao', null), 120)
          && request.resource.data.valorCentavos is int
          && request.resource.data.valorCentavos > 0
          && request.resource.data.valorCentavos <= 10000000000
          && request.resource.data.data is string
          && dataOpcional(request.resource.data.data)
          && (resource == null
                ? request.resource.data.criadoPor == request.auth.uid && request.resource.data.criadoEm == request.time
                : request.resource.data.criadoPor == resource.data.criadoPor && request.resource.data.criadoEm == resource.data.criadoEm
                    && request.resource.data.atualizadoPor == request.auth.uid && request.resource.data.atualizadoEm == request.time);
      }

      // ---------------------------------------------------------------- animais
      match /contadores/animais {
        allow read: if temPerfil(pid, ['ADMIN']);
        // Só incrementa de 1 em 1, e sempre junto com a criação de um animal.
        allow create: if temPerfil(pid, ['ADMIN'])
          && request.resource.data.keys().hasOnly(['ultimo'])
          && request.resource.data.ultimo == 1;
        allow update: if temPerfil(pid, ['ADMIN'])
          && request.resource.data.keys().hasOnly(['ultimo'])
          && request.resource.data.ultimo == resource.data.ultimo + 1;
        allow delete: if false;
      }

      match /brincos/{brinco} {
        allow read: if membroAtivo(pid);
        // "create" falha se o brinco já existir: é isso que garante a unicidade (RN-02).
        allow create: if temPerfil(pid, ['ADMIN'])
          && brincoValido(brinco)
          && request.resource.data.keys().hasOnly(['animalId'])
          && getAfter(p('animais', request.resource.data.animalId)).data.brinco == brinco;
        // Liberado apenas quando o próprio animal troca de brinco na mesma gravação.
        allow delete: if temPerfil(pid, ['ADMIN'])
          && getAfter(p('animais', resource.data.animalId)).data.brinco != brinco;
        allow update: if false;
      }

      match /animais/{animalId} {
        allow read: if membroAtivo(pid);

        // RF-03 / RN-01 / RN-02
        allow create: if temPerfil(pid, ['ADMIN'])
          && request.resource.data.keys().hasOnly([
               'codigoNumero', 'brinco', 'categoriaId', 'loteId', 'sexo', 'nome', 'dataNascimento', 'observacao',
               'situacao', 'situacaoDesde', 'versao', 'criadoPor', 'criadoEm'])
          && loteValido(request.resource.data.get('loteId', null))
          && request.resource.data.codigoNumero == getAfter(p('contadores', 'animais')).data.ultimo
          && request.resource.data.codigoNumero == (exists(p('contadores', 'animais')) ? get(p('contadores', 'animais')).data.ultimo : 0) + 1
          && brincoValido(request.resource.data.brinco)
          && getAfter(p('brincos', request.resource.data.brinco)).data.animalId == animalId
          && categoriaAtiva(request.resource.data.categoriaId)
          && request.resource.data.sexo in ['M', 'F']
          && textoOpcional(request.resource.data.nome, 80)
          && textoOpcional(request.resource.data.observacao, 500)
          && dataOpcional(request.resource.data.dataNascimento)
          && request.resource.data.situacao == 'ATIVO'
          && request.resource.data.situacaoDesde == request.time
          && request.resource.data.versao == 0
          && request.resource.data.criadoPor == request.auth.uid
          && request.resource.data.criadoEm == request.time
          && auditoriaGravada('animal', animalId, 0)
          && auditoriaDe('animal', animalId, 0).acao == 'CRIAR_ANIMAL';

        // RF-04 / RF-05: código interno e criação nunca mudam; toda edição gera auditoria.
        allow update: if temPerfil(pid, ['ADMIN'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'brinco', 'categoriaId', 'loteId', 'sexo', 'nome', 'dataNascimento', 'observacao',
               'situacao', 'situacaoDesde', 'versao', 'atualizadoPor', 'atualizadoEm'])
          && (request.resource.data.get('loteId', null) == resource.data.get('loteId', null)
                || loteValido(request.resource.data.get('loteId', null)))
          && request.resource.data.versao == resource.data.versao + 1
          && request.resource.data.atualizadoPor == request.auth.uid
          && request.resource.data.atualizadoEm == request.time
          && brincoValido(request.resource.data.brinco)
          && (request.resource.data.brinco == resource.data.brinco || (
                getAfter(p('brincos', request.resource.data.brinco)).data.animalId == animalId
                && !existsAfter(p('brincos', resource.data.brinco))))
          && (request.resource.data.categoriaId == resource.data.categoriaId || categoriaAtiva(request.resource.data.categoriaId))
          && request.resource.data.sexo in ['M', 'F']
          && textoOpcional(request.resource.data.nome, 80)
          && textoOpcional(request.resource.data.observacao, 500)
          && dataOpcional(request.resource.data.dataNascimento)
          && request.resource.data.situacao in ['ATIVO', 'VENDIDO', 'MORTO', 'TRANSFERIDO']
          && (request.resource.data.situacao == resource.data.situacao
                ? request.resource.data.situacaoDesde == resource.data.situacaoDesde
                : (request.resource.data.situacaoDesde == request.time
                   && textoObrigatorio(auditoriaDe('animal', animalId, request.resource.data.versao).motivo, 500)))
          && auditoriaGravada('animal', animalId, request.resource.data.versao);

        allow delete: if false;
      }

      // -------------------------------------------------------------- pesagens
      match /pesagens/{pesagemId} {
        allow read: if membroAtivo(pid);

        // RF-07 / RF-14: UUID do aparelho como ID (RN-13). Pode chegar offline,
        // então só valida autorização e formato (o app valida o mesmo antes).
        allow create: if temPerfil(pid, ['ADMIN', 'OPERADOR'])
          && pesagemId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
          && request.resource.data.keys().hasAll(['animalId', 'pesoG', 'dataHoraPesagem', 'fuso', 'estado', 'versao', 'criadoPor', 'criadoEm'])
          && request.resource.data.keys().hasOnly(['animalId', 'pesoG', 'dataHoraPesagem', 'fuso', 'observacao', 'estado', 'versao', 'criadoPor', 'criadoEm'])
          && exists(p('animais', request.resource.data.animalId))
          && pesoValido(request.resource.data.pesoG)
          && request.resource.data.dataHoraPesagem is timestamp
          && request.resource.data.fuso is string && request.resource.data.fuso.size() <= 64
          && textoOpcional(request.resource.data.get('observacao', null), 500)
          && request.resource.data.estado == 'VALIDA'
          && request.resource.data.versao == 0
          && request.resource.data.criadoPor == request.auth.uid
          && request.resource.data.criadoEm == request.time;

        // RF-09 / RN-11: só ADMIN, com motivo, e com auditoria antes/depois
        // gravada junto. Anular tira a pesagem dos cálculos sem apagar.
        allow update: if temPerfil(pid, ['ADMIN'])
          && resource.data.estado == 'VALIDA'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'pesoG', 'dataHoraPesagem', 'estado', 'motivoCorrecao', 'versao', 'atualizadoPor', 'atualizadoEm'])
          && request.resource.data.estado in ['VALIDA', 'ANULADA']
          && pesoValido(request.resource.data.pesoG)
          && request.resource.data.dataHoraPesagem is timestamp
          && textoObrigatorio(request.resource.data.motivoCorrecao, 500)
          && request.resource.data.versao == resource.data.versao + 1
          && request.resource.data.atualizadoPor == request.auth.uid
          && request.resource.data.atualizadoEm == request.time
          && auditoriaGravada('pesagem', pesagemId, request.resource.data.versao)
          && auditoriaDe('pesagem', pesagemId, request.resource.data.versao).motivo == request.resource.data.motivoCorrecao
          && auditoriaDe('pesagem', pesagemId, request.resource.data.versao).antes.pesoG == resource.data.pesoG
          && auditoriaDe('pesagem', pesagemId, request.resource.data.versao).antes.dataHoraPesagem == resource.data.dataHoraPesagem
          && auditoriaDe('pesagem', pesagemId, request.resource.data.versao).depois.pesoG == request.resource.data.pesoG
          && auditoriaDe('pesagem', pesagemId, request.resource.data.versao).depois.dataHoraPesagem == request.resource.data.dataHoraPesagem
          && auditoriaDe('pesagem', pesagemId, request.resource.data.versao).depois.estado == request.resource.data.estado;

        allow delete: if false;
      }

      // ------------------------------------------------------------- auditoria
      // ID determinístico {entidade}_{registroId}_v{versao}: cada versão de um
      // registro tem exatamente um registro de auditoria, que nunca muda.
      match /auditoria/{auditoriaId} {
        allow read: if temPerfil(pid, ['ADMIN']);
        allow create: if temPerfil(pid, ['ADMIN'])
          && request.resource.data.keys().hasOnly([
               'usuarioId', 'entidade', 'registroId', 'versao', 'acao', 'motivo', 'antes', 'depois', 'em'])
          && request.resource.data.entidade in ['animal', 'pesagem']
          && request.resource.data.versao is int
          && auditoriaId == request.resource.data.entidade + '_' + request.resource.data.registroId + '_v' + string(request.resource.data.versao)
          && getAfter(p(request.resource.data.entidade == 'animal' ? 'animais' : 'pesagens', request.resource.data.registroId)).data.versao == request.resource.data.versao
          && request.resource.data.acao is string
          && textoOpcional(request.resource.data.motivo, 500)
          && request.resource.data.usuarioId == request.auth.uid
          && request.resource.data.em == request.time;
        allow update, delete: if false;
      }
    }
  }
}
