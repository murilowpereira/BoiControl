# Copie para .env.local e preencha com os dados do projeto Firebase (Console > Configurações do projeto).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Chave pública do reCAPTCHA Enterprise para o App Check (produção/homologação).
VITE_APPCHECK_SITE_KEY=
# "true" para usar o Emulator Suite local.
VITE_USAR_EMULADORES=true
